<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.betta.eng.mapper.EngArticleGroupMapper">
    <resultMap id="GroupMap" type="EngArticleGroup">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="comment" column="comment"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>
    <sql id="columns">
        id,name,comment,status,create_by,create_time,update_by,update_time
    </sql>
    <select id="selectEngArticleGroupById" resultMap="GroupMap">
        select <include refid="columns"/> from eng_article_group where id=#{id}
    </select>
    <select id="selectEngArticleGroupList" parameterType="EngArticleGroup" resultMap="GroupMap">
        select <include refid="columns"/> from eng_article_group
        <where>
            <if test="name!=null and name!=''">
                and name like concat('%',#{name},'%')
            </if>
        </where>
        order by name
    </select>
    <insert id="insertEngArticleGroup" parameterType="EngArticleGroup" useGeneratedKeys="true" keyProperty="id">
        insert into eng_article_group(name,comment,status,create_by,create_time)
        values(#{name},#{comment},#{status},#{createBy},now())
    </insert>
    <update id="updateEngArticleGroup" parameterType="EngArticleGroup">
        update eng_article_group
        set name=#{name},comment=#{comment},status=#{status},update_by=#{updateBy},update_time=now()
        where id=#{id}
    </update>
    <delete id="deleteEngArticleGroupByIds">
        delete from eng_article_group where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <select id="countArticleByGroupId" resultType="int">
        select count(*) from eng_article where group_id=#{id}
    </select>
</mapper>
