<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.betta.eng.mapper.EngStudyAdminMapper">
    <resultMap id="AdminUserMap" type="EngStudyAdminUserVo">
        <id property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="nickName" column="nick_name"/>
        <result property="totalScore" column="total_score"/>
        <result property="studyCount" column="study_count"/>
        <result property="lastStudyTime" column="last_study_time"/>
    </resultMap>

    <resultMap id="StudyRecordMap" type="EngStudyRecord">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="articleId" column="article_id"/>
        <result property="articleTitle" column="article_title"/>
        <result property="score" column="score"/>
        <result property="correctCount" column="correct_count"/>
        <result property="totalCount" column="total_count"/>
        <result property="passed" column="passed"/>
        <result property="coinReward" column="coin_reward"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectUserScoreList" parameterType="EngStudyAdminUserVo" resultMap="AdminUserMap">
        select u.user_id,
               u.user_name,
               u.nick_name,
               coalesce(sum(r.score), 0) total_score,
               count(r.id) study_count,
               max(r.create_time) last_study_time
        from sys_user u
        left join eng_study_record r on r.user_id = u.user_id
        where u.del_flag = '0'
        <if test="userName != null and userName != ''">
            and u.user_name like concat('%', #{userName}, '%')
        </if>
        <if test="nickName != null and nickName != ''">
            and u.nick_name like concat('%', #{nickName}, '%')
        </if>
        group by u.user_id, u.user_name, u.nick_name
        order by total_score desc, u.user_id asc
    </select>

    <select id="selectUserScoreHistory" resultMap="StudyRecordMap">
        select r.id,
               r.user_id,
               r.article_id,
               a.title article_title,
               r.score,
               r.correct_count,
               r.total_count,
               r.passed,
               r.coin_reward,
               r.create_by,
               r.create_time
        from eng_study_record r
        left join eng_article a on a.id = r.article_id
        where r.user_id = #{userId}
        order by r.create_time desc, r.id desc
    </select>
</mapper>
